# URL công khai của ứng dụng (dùng cho metadata, sitemap, redirect sau khi đặt lại mật khẩu...)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Thông tin dự án Supabase — lấy tại Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — CHỈ dùng ở phía server (server actions, scripts/seed-demo-users.ts).
# TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_, không commit giá trị thật, không đưa vào trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flag AI Speech Coach — MVP chưa tích hợp AI thật, luôn để false trong production.
NEXT_PUBLIC_ENABLE_AI_SPEECH_COACH=false

# Giới hạn dung lượng upload (MB)
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_MB=200
NEXT_PUBLIC_MAX_AUDIO_UPLOAD_MB=50

# Tùy chọn — chỉ cần khi chạy Playwright e2e cho các luồng yêu cầu đăng nhập
# (student/teacher/parent/admin) nhắm vào một Supabase project test đã seed dữ liệu demo.
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
# E2E_TEACHER_EMAIL=
# E2E_TEACHER_PASSWORD=
# E2E_PARENT_EMAIL=
# E2E_PARENT_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
